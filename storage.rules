rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function estaAutenticado() {
      return request.auth != null;
    }

    // Lo "correcto" seria validar aca (como ya hace firestore.rules)
    // que quien escribe es el Maestro DE ESE torneo especifico, via
    // firestore.get(/databases/(default)/documents/usuarios/$(uid)).
    // Esa consulta cruzada Storage -> Firestore esta rota en este
    // proyecto (confirmado con un script aislado: el perfil en
    // Firestore es correcto - role:'master', torneoId correcto - y
    // aun asi Storage devuelve storage/unauthorized para CUALQUIER
    // regla que dependa de ella, incluida esta, ya rota desde antes de
    // tocar nada de publicidad). Sin Cloud Functions en este proyecto
    // no hay forma de usar custom claims como alternativa. Decision de
    // Luis (2026-09-10): exigir solo estar autenticado (Maestro o
    // delegado, de CUALQUIER torneo) hasta resolver la causa de fondo -
    // el riesgo que queda es que alguien de OTRO colegio sobreescriba
    // el archivo de este (nunca una fuga de datos privados, que sigue
    // 100% protegida por firestore.rules).
    function estaAutenticadoEnElTorneo(torneoId) {
      return estaAutenticado()
    }

    // Documento de "bases" de cada torneo (PDF, un unico archivo activo
    // por tenant, se sobreescribe en cada subida - ver
    // torneoConfigService.subirBases). Lectura publica: el link
    // /campeonato/{torneoId} es publico.
    match /torneo/{torneoId}/{archivo} {
      allow read: if true;
      allow write: if estaAutenticadoEnElTorneo(torneoId) &&
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType == 'application/pdf';
    }

    // Imagenes de los banners de publicidad (ver PublicidadBanner.jsx,
    // torneoPublicidadService.js) - ya se recomprimen/redimensionan en
    // el navegador antes de subir, asi que el tope de 4MB es solo un
    // resguardo, no el tamaño esperado real.
    //
    // create/update separado de delete: request.resource (de donde
    // salen size/contentType) no existe en un borrado, asi que
    // exigirlo tambien para delete tira storage/unauthorized SIEMPRE
    // que se borra un archivo (bug real, encontrado al borrar un
    // anuncio de prueba - eliminarPublicidad/eliminarFotoJugador/
    // eliminarFotoEquipo quedaban con el doc de Firestore borrado pero
    // el archivo huerfano en Storage para siempre).
    match /torneo/{torneoId}/publicidad/{archivo} {
      allow read: if true;
      allow create, update: if estaAutenticadoEnElTorneo(torneoId) &&
        request.resource.size < 4 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
      allow delete: if estaAutenticadoEnElTorneo(torneoId);
    }

    // Foto de un jugador, para identificarlo de un vistazo (ver
    // DetalleEquipo, pestaña Jugadores / torneoJugadoresService.js).
    match /torneo/{torneoId}/jugadores/{archivo} {
      allow read: if true;
      allow create, update: if estaAutenticadoEnElTorneo(torneoId) &&
        request.resource.size < 4 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
      allow delete: if estaAutenticadoEnElTorneo(torneoId);
    }

    // Fotos de la galeria de recuerdos de una promocion/equipo (ver
    // DetalleEquipo, pestaña Galeria de fotos / torneoGaleriaEquipoService.js).
    match /torneo/{torneoId}/equipos/{equipoId}/galeria/{archivo} {
      allow read: if true;
      allow create, update: if estaAutenticadoEnElTorneo(torneoId) &&
        request.resource.size < 4 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
      allow delete: if estaAutenticadoEnElTorneo(torneoId);
    }

    // Foto de portada de una promocion/equipo (ver TabEquipos,
    // torneoEquiposService.actualizarFotoPortadaEquipo) - se muestra en
    // vez del escudo con la inicial en Jugadores y en la ficha de la
    // promocion (ver EscudoEquipo).
    match /torneo/{torneoId}/equipos/{equipoId}/portada.jpg {
      allow read: if true;
      allow create, update: if estaAutenticadoEnElTorneo(torneoId) &&
        request.resource.size < 4 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
      allow delete: if estaAutenticadoEnElTorneo(torneoId);
    }
  }
}
