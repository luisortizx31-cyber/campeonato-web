# Copia este archivo a .env.local y completa los valores reales.
# .env.local nunca se sube a git (ver .gitignore).

# Firebase Console > Configuracion del proyecto > Tus apps > app Web >
# Configuracion del SDK (o "Fragmento de configuracion").
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Token de VerificaPE (api.verificape.com) para autocompletar nombres
# por DNI - se puede reusar el mismo token que ya usa prestamos-web.
VITE_APIPERU_TOKEN=
