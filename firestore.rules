rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------
    // Helpers
    // ---------------------------------------------------------------
    function estaAutenticado() {
      return request.auth != null;
    }

    function perfilDe(uid) {
      return get(/databases/$(database)/documents/usuarios/$(uid)).data;
    }

    function rolDe(uid) {
      return perfilDe(uid).role;
    }

    // A que torneo (tenant) pertenece el usuario logueado - todo dato
    // de un colegio queda marcado con este mismo torneoId, y esta
    // funcion es la que impide que un colegio toque los datos de otro.
    function miTorneoId() {
      return perfilDe(request.auth.uid).torneoId;
    }

    // Un superAdmin puede deshabilitar un colegio sin borrar sus datos
    // (ver SeccionColegios / /torneos/{torneoId}.suspendido) - esMaestro()
    // se apoya en esto para que, una vez deshabilitado, el propio
    // Maestro pierda TODOS los permisos de escritura de una sola vez
    // (todas las reglas de abajo dependen de esMaestro()/esMaestroDe()).
    // El exists() de arranque es obligatorio: get() sobre un doc que no
    // existe ABORTA toda la evaluacion de la regla (no devuelve
    // null/false), asi que sin este chequeo cualquier torneoId sin su
    // doc /torneos - por lo que sea - tira "Missing or insufficient
    // permissions" en TODAS las escrituras del Maestro, no solo en el
    // caso puntual que se queria bloquear.
    function torneoSuspendido(torneoId) {
      return exists(/databases/$(database)/documents/torneos/$(torneoId))
        && get(/databases/$(database)/documents/torneos/$(torneoId)).data.suspendido == true;
    }

    function esMaestro() {
      return estaAutenticado() && rolDe(request.auth.uid) == 'master' && !torneoSuspendido(perfilDe(request.auth.uid).torneoId);
    }

    function esMaestroDe(torneoId) {
      return esMaestro() && miTorneoId() == torneoId;
    }

    // Cuenta habilitada para dar de alta colegios/torneos nuevos desde
    // /admin (ver superadminService.js). No es un rol aparte: sigue
    // siendo 'master' de su propio torneo, y ademas tiene este flag.
    function esSuperAdmin() {
      return estaAutenticado() && perfilDe(request.auth.uid).superAdmin == true;
    }

    // ---------------------------------------------------------------
    // /usuarios - un colegio = un usuario con role:'master' y su
    // torneoId asignado. El alta (Authentication + este doc) la hace
    // un superAdmin desde /admin, o a mano por consola de Firebase.
    // list/update/delete quedan en false: ni el propio usuario ni
    // ningun otro cliente puede tocarlos por la app.
    // ---------------------------------------------------------------
    match /usuarios/{uid} {
      allow get: if estaAutenticado() && request.auth.uid == uid;
      allow create: if esSuperAdmin();
      allow list, update, delete: if false;
    }

    // /torneos/{torneoId}: metadata del tenant (nombre para mostrar en
    // la pagina publica). Lectura publica porque la pagina /campeonato
    // no tiene login. El alta la hace un superAdmin junto con el doc
    // de /usuarios de arriba.
    // El update lo puede hacer el propio Maestro (edita el nombre de
    // su colegio) O el superAdmin (deshabilita/habilita, o corrige el
    // nombre desde Configuracion) - esMaestroDe() sola no alcanza
    // porque, una vez suspendido, esMaestro() da false y nadie mas
    // podria revertirlo.
    match /torneos/{torneoId} {
      allow get: if true;
      allow create: if esSuperAdmin();
      allow list, delete: if false;
      allow update: if esMaestroDe(torneoId) || esSuperAdmin();
    }

    // /colegios/{torneoId}: correo y contraseña de acceso de cada
    // colegio dado de alta desde Configuracion (ver
    // superadminService.crearColegio) - a diferencia de /torneos de
    // arriba, esto NUNCA es de lectura publica porque guarda la
    // contraseña en texto plano, para que el superAdmin se la pueda
    // volver a mostrar al cliente si la pierde. El update es para
    // editar esos datos o mirrorear el flag "suspendido" desde ahi.
    match /colegios/{torneoId} {
      allow get, list: if esSuperAdmin();
      allow create, update: if esSuperAdmin();
      allow delete: if false;
    }

    // ---------------------------------------------------------------
    // Modulo "Campeonato" (multi-tenant). Lectura PUBLICA sin login en
    // todas estas colecciones - hay un link compartible por torneo
    // (ruta /campeonato/{torneoId}) para que jugadores/delegados/
    // publico vean posiciones, jugadores y amonestados desde el
    // celular sin cuenta. Solo el Maestro DEL MISMO torneoId puede
    // escribir, desde el panel admin (ruta /).
    // ---------------------------------------------------------------
    match /torneo_equipos/{equipoId} {
      allow get, list: if true;
      allow create: if esMaestro() && request.resource.data.torneoId == miTorneoId();
      allow update, delete: if esMaestroDe(resource.data.torneoId);
    }

    // /torneo_jugadores guarda SOLO datos publicos (nombre, equipo,
    // camiseta, contadores de tarjetas, bandera de suspension). El DNI
    // y el telefono del jugador NUNCA viven aca - ver la subcoleccion
    // /privado, para que el link publico de arriba jamas exponga un
    // dato personal.
    match /torneo_jugadores/{jugadorId} {
      allow get, list: if true;
      allow create: if esMaestro() && request.resource.data.torneoId == miTorneoId();
      allow update, delete: if esMaestroDe(resource.data.torneoId);

      match /privado/{docId} {
        allow get: if esMaestro() && resource.data.torneoId == miTorneoId();
        allow create: if esMaestro() && request.resource.data.torneoId == miTorneoId();
        allow update, delete: if esMaestro() && resource.data.torneoId == miTorneoId();
      }
    }

    // Habilita la collection group query sobre /privado (usada por
    // torneoJugadoresService.buscarJugadorPorDni para detectar un DNI
    // ya inscrito EN EL MISMO TORNEO sin tener que leer el DNI de cada
    // jugador uno por uno). El match anidado de arriba NO alcanza para
    // una query de collection group - Firestore exige este patron
    // {path=**} aparte. En "list", esta condicion se evalua por cada
    // documento que devuelve la query, asi que automaticamente excluye
    // los /privado de otros tenants aunque el codigo cliente no ponga
    // un where(torneoId) (la query de buscarJugadorPorDni solo filtra
    // por dni, esta regla es la que de verdad aisla por tenant).
    //
    // A proposito NO usa esMaestro() (que ahora hace un get() extra
    // para chequear suspendido): en una query "list", el costo de
    // get()/exists() de la regla se multiplica por cada documento que
    // devuelve la query (varios jugadores pueden compartir DNI vacio en
    // pruebas), y el limite de Firestore es 20 por request - con
    // suficientes jugadores esto rompia la busqueda entera con
    // "Missing or insufficient permissions". La suspension ya queda
    // cubierta igual en las reglas de escritura (esMaestro()) de abajo,
    // que al ser de un solo documento no tienen este problema.
    match /{path=**}/privado/{docId} {
      allow get, list: if estaAutenticado() && rolDe(request.auth.uid) == 'master' && resource.data.torneoId == miTorneoId();
    }

    match /torneo_partidos/{partidoId} {
      allow get, list: if true;
      allow create: if esMaestro() && request.resource.data.torneoId == miTorneoId();
      allow update, delete: if esMaestroDe(resource.data.torneoId);
    }

    // Las tarjetas tambien actualizan los contadores del jugador
    // (amarillasAcumuladas, suspendido) en la MISMA request del
    // Maestro via runTransaction (torneoTarjetasService.js) - no hay
    // Cloud Functions en este proyecto, asi que la logica de
    // suspension vive enteramente en el cliente, protegida solo por
    // esta regla.
    match /torneo_tarjetas/{tarjetaId} {
      allow get, list: if true;
      allow create: if esMaestro() && request.resource.data.torneoId == miTorneoId();
      allow update, delete: if esMaestroDe(resource.data.torneoId);
    }

    // Documentos de config (bases del torneo, umbrales de disciplina).
    // El id de cada doc ya incluye el torneoId (ver
    // torneoConfigService: "{torneoId}_general", "{torneoId}_master",
    // etc.) para que dos tenants nunca puedan pisarse el mismo doc.
    match /torneo_config/{docId} {
      allow get, list: if true;
      allow create, update: if esMaestro() && request.resource.data.torneoId == miTorneoId();
      allow delete: if esMaestroDe(resource.data.torneoId);
    }

    // Ajustes manuales de puntos (bonificaciones/sanciones) que el
    // Maestro aplica a un equipo desde Posiciones - independientes de
    // los resultados de partidos.
    match /torneo_ajustes/{ajusteId} {
      allow get, list: if true;
      allow create: if esMaestro() && request.resource.data.torneoId == miTorneoId();
      allow delete: if esMaestroDe(resource.data.torneoId);
    }

    // Goles anotados por jugador, cargados "sueltos" desde la pestaña
    // Goleadores - igual patron que torneo_ajustes: la tabla de
    // goleadores se recalcula siempre sumando estos registros, nunca
    // hay un contador guardado en el jugador.
    match /torneo_goles/{golId} {
      allow get, list: if true;
      allow create: if esMaestro() && request.resource.data.torneoId == miTorneoId();
      allow delete: if esMaestroDe(resource.data.torneoId);
    }
  }
}
