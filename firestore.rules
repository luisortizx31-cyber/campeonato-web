rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------
    // Helpers
    // ---------------------------------------------------------------
    function estaAutenticado() {
      return request.auth != null;
    }

    function perfilDe(uid) {
      return get(/databases/$(database)/documents/usuarios/$(uid)).data;
    }

    function rolDe(uid) {
      return perfilDe(uid).role;
    }

    // A que torneo (tenant) pertenece el usuario logueado - todo dato
    // de un colegio queda marcado con este mismo torneoId, y esta
    // funcion es la que impide que un colegio toque los datos de otro.
    function miTorneoId() {
      return perfilDe(request.auth.uid).torneoId;
    }

    // Un superAdmin puede deshabilitar un colegio sin borrar sus datos
    // (ver SeccionColegios / /torneos/{torneoId}.suspendido). Eso se
    // corta enteramente del lado de la app (ProtectedRoute bloquea el
    // panel, PaginaPublicaTorneo bloquea el link publico) y a
    // proposito NO se repite aca: un get() extra por escritura sobre
    // /torneos/{torneoId} termino rompiendo, de mas de una forma
    // distinta, TODAS las escrituras del Maestro (crear jugadores,
    // guardar config, cargar goles, etc) - no vale la pena la
    // complejidad para una capa de defensa extra que ademas no es lo
    // que se pidio.
    function esMaestro() {
      return estaAutenticado() && rolDe(request.auth.uid) == 'master';
    }

    function esMaestroDe(torneoId) {
      return esMaestro() && miTorneoId() == torneoId;
    }

    // Cuenta habilitada para dar de alta colegios/torneos nuevos desde
    // /admin (ver superadminService.js). No es un rol aparte: sigue
    // siendo 'master' de su propio torneo, y ademas tiene este flag.
    function esSuperAdmin() {
      return estaAutenticado() && perfilDe(request.auth.uid).superAdmin == true;
    }

    // Delegado de UN equipo puntual (ver TabConfiguracion -> Delegados
    // de equipo / PaginaPublicaTorneo). A diferencia del Maestro, solo
    // puede tocar los jugadores de su propio equipoId - nunca el resto
    // del torneo.
    function esDelegado() {
      return estaAutenticado() && rolDe(request.auth.uid) == 'delegado';
    }

    function miEquipoIdDelegado() {
      return perfilDe(request.auth.uid).equipoId;
    }

    // El Maestro habilita/cierra, partido por partido, que el delegado
    // de CADA equipo pueda armar su propia alineacion (ver
    // ControlPartido -> boton "Habilitar/Cerrar delegado" y
    // AlineacionPartidoDelegado del lado publico). Mientras esta
    // cerrado (el default, ver alternarAlineacionAbierta), el delegado
    // no puede tocar el partido para nada.
    function esDelegadoLocalDePartido() {
      return esDelegado() && miEquipoIdDelegado() == resource.data.equipoLocalId;
    }
    function esDelegadoVisitanteDePartido() {
      return esDelegado() && miEquipoIdDelegado() == resource.data.equipoVisitanteId;
    }
    // El delegado solo puede tocar los campos de alineacion de SU
    // propio lado (local o visitante) - nunca el marcador, las
    // tarjetas, ni la alineacion del rival ni los flags de apertura
    // (esos los sigue manejando solo el Maestro).
    function soloCambioAlineacion(campos) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(campos);
    }

    // ---------------------------------------------------------------
    // /usuarios - un colegio = un usuario con role:'master' y su
    // torneoId asignado. El alta (Authentication + este doc) la hace
    // un superAdmin desde /admin, o a mano por consola de Firebase.
    // list/update/delete quedan en false: ni el propio usuario ni
    // ningun otro cliente puede tocarlos por la app.
    // ---------------------------------------------------------------
    match /usuarios/{uid} {
      allow get: if estaAutenticado() && request.auth.uid == uid;
      // El superAdmin da de alta un colegio (role:'master'). El propio
      // Maestro puede dar de alta un delegado (role:'delegado') para
      // SU torneo - el rol queda fijo en 'delegado' aca mismo, para que
      // un Maestro nunca pueda crearse a si mismo (ni a nadie) como
      // 'master' de otro torneo por este camino.
      allow create: if esSuperAdmin()
                    || (esMaestro() && request.resource.data.role == 'delegado' && request.resource.data.torneoId == miTorneoId());
      allow list, update, delete: if false;
    }

    // /torneos/{torneoId}: metadata del tenant (nombre para mostrar en
    // la pagina publica). Lectura publica porque la pagina /campeonato
    // no tiene login. El alta la hace un superAdmin junto con el doc
    // de /usuarios de arriba.
    // El update lo puede hacer el propio Maestro (edita el nombre de
    // su colegio) O el superAdmin (deshabilita/habilita el campo
    // "suspendido", o corrige el nombre desde Configuracion).
    match /torneos/{torneoId} {
      allow get: if true;
      allow create: if esSuperAdmin();
      allow list, delete: if false;
      allow update: if esMaestroDe(torneoId) || esSuperAdmin();
    }

    // /colegios/{torneoId}: correo y contraseña de acceso de cada
    // colegio dado de alta desde Configuracion (ver
    // superadminService.crearColegio) - a diferencia de /torneos de
    // arriba, esto NUNCA es de lectura publica porque guarda la
    // contraseña en texto plano, para que el superAdmin se la pueda
    // volver a mostrar al cliente si la pierde. El update es para
    // editar esos datos o mirrorear el flag "suspendido" desde ahi.
    match /colegios/{torneoId} {
      allow get, list: if esSuperAdmin();
      allow create, update: if esSuperAdmin();
      allow delete: if false;
    }

    // /torneo_delegados/{uid}: correo, contraseña y equipo asignado de
    // cada delegado dado de alta desde Configuracion (ver
    // delegadosService.crearDelegado) - mismo motivo que /colegios de
    // arriba (nunca es de lectura publica: guarda la contraseña en
    // texto plano para que el Maestro se la pueda volver a mostrar).
    // El propio delegado puede leer SU documento (lo usa para saber si
    // fue deshabilitado, ver PaginaPublicaTorneo) pero nunca la lista
    // completa ni el de otro delegado.
    match /torneo_delegados/{uid} {
      allow get: if (estaAutenticado() && request.auth.uid == uid) || (esMaestro() && resource.data.torneoId == miTorneoId());
      allow list: if esMaestro() && resource.data.torneoId == miTorneoId();
      allow create: if esMaestro() && request.resource.data.torneoId == miTorneoId();
      allow update: if esMaestroDe(resource.data.torneoId);
      // No se puede des-crear la cuenta de Authentication desde el
      // cliente (requeriria Admin SDK) - "eliminar" un delegado en
      // realidad lo deshabilita (campo `deshabilitado`, ver
      // delegadosService.alternarDelegado), nunca se borra el doc.
      allow delete: if false;
    }

    // ---------------------------------------------------------------
    // Modulo "Campeonato" (multi-tenant). Lectura PUBLICA sin login en
    // todas estas colecciones - hay un link compartible por torneo
    // (ruta /campeonato/{torneoId}) para que jugadores/delegados/
    // publico vean posiciones, jugadores y amonestados desde el
    // celular sin cuenta. Solo el Maestro DEL MISMO torneoId puede
    // escribir, desde el panel admin (ruta /).
    // ---------------------------------------------------------------
    match /torneo_equipos/{equipoId} {
      allow get, list: if true;
      allow create: if esMaestro() && request.resource.data.torneoId == miTorneoId();
      allow update, delete: if esMaestroDe(resource.data.torneoId);
    }

    // /torneo_jugadores guarda SOLO datos publicos (nombre, equipo,
    // camiseta, contadores de tarjetas, bandera de suspension). El DNI
    // y el telefono del jugador NUNCA viven aca - ver la subcoleccion
    // /privado, para que el link publico de arriba jamas exponga un
    // dato personal.
    match /torneo_jugadores/{jugadorId} {
      allow get, list: if true;
      // Un delegado solo puede inscribir/editar jugadores de SU propio
      // equipo (equipoId fijo, no lo puede cambiar en un update) - el
      // resto del plantel de otros equipos queda fuera de su alcance.
      allow create: if (esMaestro() && request.resource.data.torneoId == miTorneoId())
                    || (esDelegado()
                        && request.resource.data.torneoId == perfilDe(request.auth.uid).torneoId
                        && request.resource.data.equipoId == miEquipoIdDelegado());
      allow update: if esMaestroDe(resource.data.torneoId)
                    || (esDelegado()
                        && resource.data.torneoId == perfilDe(request.auth.uid).torneoId
                        && resource.data.equipoId == miEquipoIdDelegado()
                        && request.resource.data.equipoId == resource.data.equipoId);
      allow delete: if esMaestroDe(resource.data.torneoId);

      // El doc /privado/datos es OPCIONAL (solo se crea si el jugador
      // tiene DNI o telefono cargado, ver registrarJugador) - para un
      // jugador sin ninguno de los dos, eliminarJugador igual intenta
      // borrarlo (por si acaso) y obtenerDatosPrivadosJugador igual lo
      // lee ("Ver datos"). Cuando el doc no existe, `resource` es null
      // en la regla - hay que contemplar ese caso explicitamente, si no
      // CUALQUIER operacion sobre un doc que no existe queda denegada
      // (aunque el jugador sea del propio Maestro) porque resource.data
      // no se puede leer de un resource null.
      match /privado/{docId} {
        allow get: if esMaestro() && (resource == null || resource.data.torneoId == miTorneoId());
        allow create: if esMaestro() && request.resource.data.torneoId == miTorneoId();
        allow update, delete: if esMaestro() && (resource == null || resource.data.torneoId == miTorneoId());
      }
    }

    // Habilita la collection group query sobre /privado (usada por
    // torneoJugadoresService.buscarJugadorPorDni para detectar un DNI
    // ya inscrito EN EL MISMO TORNEO sin tener que leer el DNI de cada
    // jugador uno por uno). El match anidado de arriba NO alcanza para
    // una query de collection group - Firestore exige este patron
    // {path=**} aparte. En "list", esta condicion se evalua por cada
    // documento que devuelve la query, asi que automaticamente excluye
    // los /privado de otros tenants aunque el codigo cliente no ponga
    // un where(torneoId) (la query de buscarJugadorPorDni solo filtra
    // por dni, esta regla es la que de verdad aisla por tenant).
    match /{path=**}/privado/{docId} {
      allow get, list: if esMaestro() && resource.data.torneoId == miTorneoId();
    }

    match /torneo_partidos/{partidoId} {
      allow get, list: if true;
      allow create: if esMaestro() && request.resource.data.torneoId == miTorneoId();
      allow update: if esMaestroDe(resource.data.torneoId)
                    || (esDelegadoLocalDePartido()
                        && resource.data.alineacionAbiertaLocal == true
                        && soloCambioAlineacion(['titularesLocal', 'suplentesLocal', 'dniConfirmadoLocal']))
                    || (esDelegadoVisitanteDePartido()
                        && resource.data.alineacionAbiertaVisitante == true
                        && soloCambioAlineacion(['titularesVisitante', 'suplentesVisitante', 'dniConfirmadoVisitante']));
      allow delete: if esMaestroDe(resource.data.torneoId);
    }

    // Las tarjetas tambien actualizan los contadores del jugador
    // (amarillasAcumuladas, suspendido) en la MISMA request del
    // Maestro via runTransaction (torneoTarjetasService.js) - no hay
    // Cloud Functions en este proyecto, asi que la logica de
    // suspension vive enteramente en el cliente, protegida solo por
    // esta regla.
    match /torneo_tarjetas/{tarjetaId} {
      allow get, list: if true;
      allow create: if esMaestro() && request.resource.data.torneoId == miTorneoId();
      allow update, delete: if esMaestroDe(resource.data.torneoId);
    }

    // Documentos de config (bases del torneo, umbrales de disciplina).
    // El id de cada doc ya incluye el torneoId (ver
    // torneoConfigService: "{torneoId}_general", "{torneoId}_master",
    // etc.) para que dos tenants nunca puedan pisarse el mismo doc.
    match /torneo_config/{docId} {
      allow get, list: if true;
      allow create, update: if esMaestro() && request.resource.data.torneoId == miTorneoId();
      allow delete: if esMaestroDe(resource.data.torneoId);
    }

    // Ajustes manuales de puntos (bonificaciones/sanciones) que el
    // Maestro aplica a un equipo desde Posiciones - independientes de
    // los resultados de partidos.
    match /torneo_ajustes/{ajusteId} {
      allow get, list: if true;
      allow create: if esMaestro() && request.resource.data.torneoId == miTorneoId();
      allow delete: if esMaestroDe(resource.data.torneoId);
    }

    // Goles anotados por jugador, cargados "sueltos" desde la pestaña
    // Goleadores - igual patron que torneo_ajustes: la tabla de
    // goleadores se recalcula siempre sumando estos registros, nunca
    // hay un contador guardado en el jugador.
    match /torneo_goles/{golId} {
      allow get, list: if true;
      allow create: if esMaestro() && request.resource.data.torneoId == miTorneoId();
      allow delete: if esMaestroDe(resource.data.torneoId);
    }
  }
}
